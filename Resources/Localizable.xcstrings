    },
    "OpenWebif liefert keinen vollständigen Tunerstatus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenWebif liefert keinen vollständigen Tunerstatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenWebif does not provide complete tuner status."
          }
        }
      }
    },
    "OpenWebif meldet Empfangseinheiten. Bei FBC-Tunern können mehrere Einträge zu einem physischen Modul gehören. Mehrere Sender auf demselben Transponder können eine Empfangseinheit gemeinsam nutzen. Fehlende Angaben bedeuten nicht, dass ein Tuner deaktiviert ist.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenWebif meldet Empfangseinheiten. Bei FBC-Tunern können mehrere Einträge zu einem physischen Modul gehören. Mehrere Sender auf demselben Transponder können eine Empfangseinheit gemeinsam nutzen. Fehlende Angaben bedeuten nicht, dass ein Tuner deaktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenWebif reports tuner resources. With FBC tuners, several entries may belong to one physical module. Channels on the same transponder may share a tuner resource. Missing information does not mean a tuner is disabled."
          }
        }
      }
    },
