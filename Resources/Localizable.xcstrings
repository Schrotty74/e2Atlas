    "Sprache, Darstellung, Startverbindung, EPG-Anzeigeoptionen und Zeitkürzel werden ersetzt. Vorhandene Receiver, Favoriten, Multiview-Belegungen und Themes bleiben erhalten. Ein Receiverwechsel beendet die laufende Wiedergabe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache, Darstellung, Startverbindung, EPG-Anzeigeoptionen und Zeitkürzel werden ersetzt. Vorhandene Receiver, Favoriten, Multiview-Belegungen und Themes bleiben erhalten. Ein Receiverwechsel beendet die laufende Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language, appearance, startup connection, programme refresh options and time shortcuts will be replaced. Existing receivers, favourites, multiview layouts and themes will be kept. Switching receivers stops current playback."
          }
        }
      }
    },
